# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# --- WhatsApp Cloud API (Meta for Developers > 앱 > WhatsApp > API 설정) ---
# 액세스 토큰. 운영용으로는 시스템 사용자의 영구 토큰을 쓰세요.
WHATSAPP_TOKEN=
# 비즈니스 전화번호 ID (전화번호 자체가 아니라 숫자 ID)
WHATSAPP_PHONE_NUMBER_ID=
# 앱 설정 > 기본 설정 > 앱 시크릿 코드. webhook이 진짜 Meta에서 왔는지 확인합니다.
WHATSAPP_APP_SECRET=
# webhook 등록할 때 Meta 화면에 똑같이 입력할 아무 문자열
WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v24.0

# --- 요약할 단톡방 ---
# 비워 두고 실행하면 단톡방 메시지가 올 때 로그에 group_id가 찍힙니다.
# 여러 개는 쉼표로, 알림에 표시할 이름은 =이름 으로: 120363000000000001=가족방,120363000000000002=회사
TARGET_GROUP_ID=
# 몇 개마다 요약할지
BATCH_SIZE=10

# --- 요약 알림을 받을 곳 ---
# 국가번호 포함, + 없이 (예: 821012345678)
NOTIFY_TO=
# individual(개인 번호로 받기) 또는 group(NOTIFY_TO에 group_id를 넣어 단톡방으로 받기)
NOTIFY_RECIPIENT_TYPE=individual

# --- Claude ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- 기타 ---
PORT=3000
DISPLAY_TIMEZONE=Asia/Seoul
DATA_FILE=data/state.json
